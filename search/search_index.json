{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#curtin-university-diploma","title":"\u79d1\u5ef7\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08Curtin University diploma\uff09\u771f\u5b9e\u6837\u672c\u53c2\u7167\u6bd4\u5bf9","text":"<p>\u5728\u5f53\u524d\u56fd\u9645\u5316\u4eba\u624d\u7ade\u4e89\u65e5\u76ca\u6fc0\u70c8\u7684\u80cc\u666f\u4e0b\uff0c\u62e5\u6709\u6d77\u5916\u7559\u5b66\u80cc\u666f\u7684\u6bd5\u4e1a\u751f\u5728\u6c42\u804c\u3001\u843d\u6237\u3001\u7533\u8bf7\u9ad8\u5c42\u6b21\u4eba\u624d\u8865\u8d34\u4ee5\u53ca\u5b66\u5386\u8ba4\u8bc1\u65f6\uff0c\u5176\u6d77\u5916\u5b66\u4f4d\u8bc1\u4e66\u7684\u771f\u5b9e\u6027\u4e0e\u89c4\u8303\u6027\u6210\u4e3a\u4e86\u5404\u5927\u7528\u4eba\u5355\u4f4d\u3001\u4eba\u529b\u8d44\u6e90\u90e8\u95e8\u4ee5\u53ca\u76f8\u5173\u8ba4\u8bc1\u673a\u6784\u5ba1\u67e5\u7684\u91cd\u4e2d\u4e4b\u91cd\u3002\u4f5c\u4e3a\u897f\u6fb3\u5927\u5229\u4e9a\u89c4\u6a21\u6700\u5927\u3001\u6700\u5177\u521b\u65b0\u6027\u7684\u7efc\u5408\u6027\u516c\u7acb\u5927\u5b66\uff0c\u6fb3\u6d32\u79d1\u5ef7\u5927\u5b66\uff08Curtin University\uff09\u56e0\u5176\u96c4\u539a\u7684\u79d1\u7814\u5b9e\u529b\u548c\u6781\u9ad8\u7684\u6bd5\u4e1a\u751f\u5c31\u4e1a\u7387\uff0c\u5438\u5f15\u4e86\u5927\u91cf\u56fd\u9645\u7559\u5b66\u751f\u3002</p> <p></p> <p>\u4e3a\u4e86\u5e2e\u52a9\u5e7f\u5927\u6bd5\u4e1a\u751f\u3001\u7528\u4eba\u5355\u4f4d\u4ee5\u53ca\u7b2c\u4e09\u65b9\u6838\u67e5\u673a\u6784\u51c6\u786e\u8bc6\u522b\u548c\u4e86\u89e3\u8be5\u6821\u5b66\u4f4d\u8bc1\u4e66\u7684\u89c6\u89c9\u7279\u5f81\u4e0e\u9632\u4f2a\u89c4\u8303\uff0c\u672c\u6587\u5c06\u7acb\u8db3\u4e8e\u79d1\u5ef7\u5927\u5b66\u5b98\u65b9\u9881\u53d1\u7684\u5b66\u4f4d\u8bc1\u4e66\u771f\u5b9e\u6837\u672c\uff0c\u4ece\u7eb8\u5f20\u7248\u9762\u3001\u6838\u5fc3\u89c6\u89c9\u5143\u7d20\u3001\u6587\u5b57\u6392\u7248\u7ec6\u8282\u3001\u5370\u7ae0\u5370\u8bb0\u7b49\u591a\u4e2a\u7ef4\u5ea6\u8fdb\u884c\u6df1\u5ea6\u62c6\u89e3\u4e0e\u53c2\u7167\u6bd4\u5bf9\uff0c\u4ee5\u63d0\u4f9b\u4e00\u4efd\u517c\u5177\u5b9e\u7528\u6027\u4e0e\u4e13\u4e1a\u6027\u7684\u53c2\u7167\u6307\u5357\u3002</p>"},{"location":"#_1","title":"\u6fb3\u6d32\u9ad8\u6559\u8bc1\u4e66\u4f53\u7cfb\u4e0e\u9632\u4f2a\u6280\u672f\u6982\u8ff0","text":"<p>\u5728\u6df1\u5165\u89e3\u6790\u5177\u4f53\u6837\u672c\u4e4b\u524d\uff0c\u6709\u5fc5\u8981\u5148\u4e86\u89e3\u6fb3\u6d32\u9ad8\u7b49\u6559\u80b2\u8bc1\u4e66\u4f53\u7cfb\uff08Australian Qualifications Framework, AQF\uff09\u7684\u6574\u4f53\u89c4\u8303\u3002\u6fb3\u6d32\u9ad8\u6821\u5728\u9881\u53d1\u6b63\u5f0f\u5b66\u4f4d\u8bc1\u4e66\u65f6\uff0c\u901a\u5e38\u4f1a\u9075\u5faa\u6781\u5176\u4e25\u683c\u7684\u5370\u5237\u4e0e\u8bbe\u8ba1\u6d41\u7a0b\u3002</p> <p>\u8fd9\u4e9b\u8bc1\u4e66\u4e0d\u4ec5\u4ec5\u662f\u4e00\u5f20\u7eb8\uff0c\u5b83\u627f\u8f7d\u7740\u5b66\u6821\u7684\u6cd5\u5f8b\u6548\u529b\u4e0e\u5b66\u672f\u58f0\u8a89\u3002\u901a\u5e38\u60c5\u51b5\u4e0b\uff0c\u771f\u6b63\u7684\u5b66\u4f4d\u8bc1\u4e66\u4f1a\u91c7\u7528\u7279\u5b9a\u514b\u91cd\u7684\u7279\u79cd\u8bc1\u5238\u7eb8\u5f20\uff0c\u5177\u6709\u72ec\u7279\u7684\u8d28\u611f\u4e0e\u6297\u8001\u5316\u7279\u6027\u3002\u9632\u4f2a\u6280\u672f\u5219\u6db5\u76d6\u4e86\u9ad8\u7cbe\u5ea6\u5e95\u7eb9\u5370\u5237\u3001\u5fae\u7f29\u6587\u5b57\u3001\u4e13\u5c5e\u70eb\u91d1\u6216\u538b\u7eb9\u5370\u7ae0\u7b49\u591a\u79cd\u590d\u5408\u624b\u6bb5\u3002\u901a\u8fc7\u4e86\u89e3\u8fd9\u4e9b\u5b8f\u89c2\u5c42\u9762\u7684\u6280\u672f\u80cc\u666f\uff0c\u6211\u4eec\u5728\u8fdb\u884c\u5b9e\u7269\u6216\u9ad8\u6e05\u626b\u63cf\u4ef6\u6bd4\u5bf9\u65f6\uff0c\u5c31\u80fd\u66f4\u6709\u9488\u5bf9\u6027\u5730\u6355\u6349\u5173\u952e\u6280\u672f\u8282\u70b9\u3002</p>"},{"location":"#_2","title":"\u79d1\u5ef7\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6838\u5fc3\u89c6\u89c9\u5143\u7d20\u6df1\u5ea6\u89e3\u6790","text":"<p>\u6839\u636e\u79d1\u5ef7\u5927\u5b66\u5b98\u65b9\u6807\u51c6\u7684\u771f\u5b9e\u6bd5\u4e1a\u8bc1\u4e66\u6837\u672c\uff0c\u6574\u4e2a\u8bc1\u4e66\u7684\u89c6\u89c9\u5e03\u5c40\u5448\u73b0\u51fa\u4e00\u79cd\u65e2\u5e84\u4e25\u53c8\u73b0\u4ee3\u7684\u8bbe\u8ba1\u7f8e\u5b66\u3002\u4ee5\u4e0b\u662f\u8bc1\u4e66\u6b63\u9762\u6700\u4e3a\u6838\u5fc3\u3001\u6700\u5177\u8fa8\u8bc6\u5ea6\u7684\u51e0\u5927\u89c6\u89c9\u5143\u7d20\uff1a</p>"},{"location":"#1-the-university-coat-of-arms-logo","title":"1. \u9876\u90e8\u6821\u5fbd\u4e0e\u6838\u5fc3\u6807\u8bc6\uff08The University Coat of Arms / Logo\uff09","text":"<p>\u5728\u8bc1\u4e66\u7684\u6b63\u4e0a\u65b9\u5c45\u4e2d\u4f4d\u7f6e\uff0c\u8d6b\u7136\u5370\u6709\u79d1\u5ef7\u5927\u5b66\u7684\u5b98\u65b9\u6807\u5fd7\u3002\u771f\u5b9e\u7684\u6807\u8bc6\u8bbe\u8ba1\u6781\u5176\u8003\u7a76\uff0c\u5b83\u7531\u4e00\u4e2a\u5782\u76f4\u7684\u58a8\u7eff\u8272\u957f\u65b9\u5f62\u5757\u6784\u6210\uff0c\u65b9\u5757\u4e2d\u592e\u5d4c\u6709\u4e00\u4e2a\u91d1\u9ec4\u8272\u7684\u76fe\u5fbd\uff08\u6216\u9f7f\u8f6e\u72b6\u51e0\u4f55\u56fe\u5f62\uff0c\u8c61\u5f81\u7740\u79d1\u6280\u3001\u521b\u65b0\u4e0e\u5de5\u4e1a\u5927\u5b66\u7684\u6e0a\u6e90\uff09\u3002 * \u8272\u5f69\u6807\u51c6\uff1a \u58a8\u7eff\u8272\u4e0e\u91d1\u9ec4\u8272\u7684\u642d\u914d\u6709\u7740\u4e25\u683c\u7684RGB\u4e0eCMYK\u8272\u503c\u6807\u51c6\uff0c\u6574\u4f53\u8272\u5f69\u9971\u6ee1\u3001\u8fb9\u7f18\u6e05\u6670\uff0c\u6ca1\u6709\u4efb\u4f55\u91cd\u5f71\u6216\u6bdb\u523a\u611f\u3002 * \u5370\u5237\u5de5\u827a\uff1a \u5728\u5b9e\u7269\u8bc1\u4e66\u4e0a\uff0c\u8be5\u6821\u5fbd\u533a\u57df\u7684\u6cb9\u58a8\u9644\u7740\u5747\u5300\uff0c\u9ad8\u7cbe\u5ea6\u5370\u5237\u4f7f\u5f97\u5176\u4e2d\u7ec6\u5bc6\u7684\u6a2a\u5411\u7ebf\u6761\u5373\u4f7f\u5728\u653e\u5927\u955c\u4e0b\u4e5f\u6e05\u6670\u53ef\u89c1\u3002</p>"},{"location":"#2-the-authority-statement","title":"2. \u6821\u540d\u4e0e\u6388\u8854\u5ba3\u8a00\uff08The Authority Statement\uff09","text":"<p>\u6821\u5fbd\u4e0b\u65b9\u4e3a\u5927\u5b66\u7684\u6cd5\u5b9a\u5168\u79f0\u201cCURTIN UNIVERSITY\u201d\uff0c\u901a\u5e38\u91c7\u7528\u5927\u5199\u3001\u6709\u886c\u7ebf\u7684\u4f18\u96c5\u5b57\u4f53\u3002\u7d27\u63a5\u7740\u662f\u4e00\u884c\u5e84\u91cd\u7684\u5ba3\u544a\u8bed\uff1a\u201cBY AUTHORITY OF THE COUNCIL BE IT KNOWN\u201d\uff08\u7ecf\u5927\u5b66\u7406\u4e8b\u4f1a\u6388\u6743\uff0c\u7279\u6b64\u5ba3\u544a\uff09\u3002 * \u5b57\u4f53\u6392\u7248\uff1a \u8fd9\u90e8\u5206\u6587\u5b57\u7684\u5b57\u95f4\u8ddd\u7ecf\u8fc7\u7cbe\u5fc3\u8bbe\u8ba1\uff0c\u6574\u4f53\u89c6\u89c9\u4e2d\u5fc3\u5bf9\u79f0\uff0c\u6392\u7248\u9519\u843d\u6709\u81f4\uff0c\u4f53\u73b0\u51fa\u5b66\u672f\u6587\u4ef6\u7684\u4e25\u8c28\u6027\u3002</p>"},{"location":"#_3","title":"\u5b66\u4f4d\u6388\u4e88\u6838\u5fc3\u4fe1\u606f\u533a\u57df\u6392\u7248\u89c4\u8303","text":"<p>\u8bc1\u4e66\u7684\u4e2d\u90e8\u662f\u6574\u5f20\u6587\u4ef6\u7684\u6838\u5fc3\u5185\u5bb9\u533a\uff0c\u7528\u4e8e\u8bb0\u8f7d\u6bd5\u4e1a\u751f\u7684\u4e2a\u4eba\u8eab\u4efd\u4fe1\u606f\u4ee5\u53ca\u6240\u83b7\u5f97\u7684\u5b66\u672f\u6210\u5c31\u3002\u5728\u771f\u5b9e\u7684\u6837\u672c\u4e2d\uff0c\u8fd9\u4e00\u533a\u57df\u7684\u6587\u672c\u6392\u7248\u548c\u7528\u8bcd\u6709\u7740\u56fa\u5b9a\u7684\u903b\u8f91\u3002</p>"},{"location":"#1-graduate-name","title":"1. \u6bd5\u4e1a\u751f\u59d3\u540d\uff08Graduate Name\uff09","text":"<p>\u59d3\u540d\u4f4d\u4e8e\u6388\u8854\u5ba3\u8a00\u4e0b\u65b9\uff0c\u901a\u5e38\u4f7f\u7528\u8f83\u5927\u5b57\u53f7\u7684\u9ed1\u4f53\u6216\u52a0\u7c97\u886c\u7ebf\u4f53\u8fdb\u884c\u5f3a\u8c03\u3002\u7531\u4e8e\u9690\u79c1\u4fdd\u62a4\uff0c\u771f\u5b9e\u6837\u672c\u4e2d\u5f80\u5f80\u4f1a\u5bf9\u8be5\u90e8\u5206\u8fdb\u884c\u6a21\u7cca\u5904\u7406\uff0c\u4f46\u5728\u4e0b\u53d1\u7684\u539f\u4ef6\u4e2d\uff0c\u82f1\u6587\u59d3\u540d\uff08\u6216\u62fc\u97f3\uff09\u7684\u62fc\u5199\u5fc5\u987b\u4e0e\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u62a4\u7167\u5b8c\u5168\u4e00\u81f4\u3002</p>"},{"location":"#2-degree-and-major","title":"2. \u5b66\u4f4d\u540d\u79f0\u4e0e\u4e13\u4e1a\u65b9\u5411\uff08Degree and Major\uff09","text":"<p>\u59d3\u540d\u4e4b\u4e0b\uff0c\u4f1a\u660e\u786e\u5199\u51fa\u201cHAVING FULFILLED ALL THE REQUIREMENTS IS DULY ADMITTED TO THE DEGREE OF\u201d\uff08\u5728\u6ee1\u8db3\u6240\u6709\u8981\u6c42\u540e\uff0c\u6b63\u5f0f\u6388\u4e88\u4ee5\u4e0b\u5b66\u4f4d\uff09\u3002\u968f\u540e\u5219\u662f\u5177\u4f53\u7684\u5b66\u4f4d\u540d\u79f0\u3002 \u4ee5\u5e38\u89c1\u7684\u8ba1\u7b97\u673a\u6216\u5de5\u7a0b\u7c7b\u4e13\u4e1a\u4e3a\u4f8b\uff0c\u6837\u672c\u4e2d\u6e05\u6670\u5370\u6709\uff1a * BACHELOR OF COMPUTING\uff08\u8ba1\u7b97\u79d1\u5b66\u5b66\u58eb\uff09 * (SOFTWARE ENGINEERING)\uff08\u8f6f\u4ef6\u5de5\u7a0b\u65b9\u5411\uff09 * WITH DISTINCTION\uff08\u5353\u8d8a/\u4f18\u79c0\u6bd5\u4e1a\u8363\u8a89\uff09</p> <p>\u6ce8\u610f\uff1a \u5982\u679c\u6bd5\u4e1a\u751f\u5728\u6821\u6210\u7ee9\u4f18\u5f02\uff0c\u8fbe\u5230\u5b66\u6821\u89c4\u5b9a\u7684\u5353\u8d8a\u6807\u51c6\uff0c\u8bc1\u4e66\u4e0a\u4f1a\u660e\u786e\u52a0\u6ce8\u201cWITH DISTINCTION\u201d\u7b49\u8363\u8a89\u5b57\u6837\uff0c\u8fd9\u4e00\u5b57\u6837\u7684\u5b57\u4f53\u3001\u5b57\u53f7\u4ee5\u53ca\u4e0e\u4e0a\u65b9\u5b66\u4f4d\u540d\u79f0\u7684\u5bf9\u9f50\u65b9\u5f0f\u90fd\u662f\u56fa\u5b9a\u4e14\u4e25\u4e1d\u5408\u7f1d\u7684\u3002</p>"},{"location":"#_4","title":"\u8bc1\u4e66\u5e95\u90e8\u6cd5\u5f8b\u6548\u529b\u4e0e\u7b7e\u7ae0\u6bd4\u5bf9","text":"<p>\u5b66\u4f4d\u8bc1\u4e66\u4e0d\u4ec5\u662f\u4e00\u4efd\u5b66\u672f\u8bc1\u660e\uff0c\u66f4\u662f\u4e00\u4efd\u5177\u5907\u6cd5\u5f8b\u6548\u529b\u7684\u6cd5\u5b9a\u6587\u4ef6\u3002\u56e0\u6b64\uff0c\u8bc1\u4e66\u5e95\u90e8\u7684\u6cd5\u5f8b\u5ba3\u544a\u8bcd\u3001\u5b98\u65b9\u7ea2\u5370\u4ee5\u53ca\u5b98\u5458\u7b7e\u540d\u662f\u6838\u67e5\u7684\u91cd\u4e2d\u4e4b\u91cd\u3002</p>"},{"location":"#1-the-graduation-seal-clause","title":"1. \u6cd5\u5b9a\u5ba3\u8a93\u8bcd\uff08The Graduation Seal Clause\uff09","text":"<p>\u5728\u5b66\u4f4d\u4fe1\u606f\u4e0b\u65b9\uff0c\u5370\u6709\u5982\u4e0b\u4e00\u6bb5\u6587\u5b57\uff1a\u201cTO ALL THE PRIVILEGES ATTACHED TO THE SAME. THE GRADUATION SEAL OF CURTIN UNIVERSITY WAS HERETO AFFIXED PURSUANT TO A RESOLUTION OF THE COUNCIL.\u201d\uff08\u4eab\u6709\u4e0e\u5176\u76f8\u5173\u7684\u6240\u6709\u6743\u76ca\u3002\u672c\u6821\u6bd5\u4e1a\u5370\u7ae0\u7cfb\u6839\u636e\u7406\u4e8b\u4f1a\u51b3\u8bae\u5728\u6b64\u52a0\u76d6\u3002\uff09\u8fd9\u6bb5\u8bdd\u660e\u786e\u4e86\u8be5\u8bc1\u4e66\u7684\u6cd5\u5f8b\u6765\u6e90\u3002</p>"},{"location":"#2-the-graduation-seal","title":"2. \u94a2\u5370\u4e0e\u7ea2\u5370\uff08The Graduation Seal\uff09","text":"<p>\u5728\u8bc1\u4e66\u7684\u5e95\u90e8\u4e2d\u592e\uff0c\u52a0\u76d6\u6709\u79d1\u5ef7\u5927\u5b66\u5f15\u4eba\u6ce8\u76ee\u7684\u5927\u7ea2\u5e95\u7eb9\u6bd5\u4e1a\u5370\u7ae0\u3002 * \u5916\u89c2\u7279\u5f81\uff1a \u8be5\u5370\u7ae0\u4e3a\u5706\u5f62\uff0c\u8fb9\u7f18\u5448\u73b0\u89c4\u6574\u7684\u653e\u5c04\u72b6\u9f7f\u8f6e/\u952f\u9f7f\u5f62\u6001\uff0c\u5185\u90e8\u5370\u6709\u5b66\u6821\u7684\u5b66\u672f\u6807\u5fd7\u6216\u6838\u5fc3\u5b57\u6837\u3002 * \u5de5\u827a\u7ec6\u8282\uff1a \u5728\u771f\u5b9e\u7684\u539f\u4ef6\u4e0a\uff0c\u8fd9\u4e2a\u7ea2\u5370\u901a\u5e38\u7ed3\u5408\u4e86\u9ad8\u7cbe\u5ea6\u7684\u5f69\u8272\u5370\u5237\u4e0e\u7cbe\u51c6\u7684\u51f9\u51f8\u538b\u5370\uff08\u94a2\u5370\uff09\u6280\u672f\u3002\u89e6\u6478\u5b9e\u7269\u65f6\uff0c\u53ef\u4ee5\u6e05\u6670\u5730\u611f\u89c9\u5230\u7eb8\u5f20\u8868\u9762\u6709\u5fae\u5fae\u7684\u51f9\u51f8\u611f\uff0c\u4e14\u7ea2\u5370\u7684\u989c\u8272\u5728\u4e0d\u540c\u5149\u7ebf\u4e0b\u5448\u73b0\u51fa\u6c89\u7a33\u7684\u7ea2\u8272\uff0c\u800c\u975e\u5ec9\u4ef7\u7684\u523a\u773c\u9c9c\u7ea2\u3002</p>"},{"location":"#3-official-signatures","title":"3. \u5b98\u5458\u7b7e\u540d\uff08Official Signatures\uff09","text":"<p>\u7ea2\u5370\u7684\u5de6\u4fa7 and \u53f3\u4fa7\uff0c\u5206\u522b\u5bf9\u5e94\u7740\u5b66\u6821\u4e24\u4f4d\u6700\u9ad8\u884c\u653f\u4e0e\u5b66\u672f\u957f\u5b98\u7684\u6cd5\u5b9a\u7b7e\u540d\u3002 * \u5de6\u4fa7\uff1a Chancellor\uff08\u6821\u76d1/\u5927\u5b66\u6821\u8463\u4f1a\u4e3b\u5e2d\uff09\u7684\u7b7e\u540d\u3002 * \u53f3\u4fa7\uff1a Vice-Chancellor\uff08\u6821\u957f/\u526f\u6821\u76d1\uff09\u7684\u7b7e\u540d\u3002 * \u6bd4\u5bf9\u8981\u70b9\uff1a \u771f\u5b9e\u7684\u6bd5\u4e1a\u8bc1\u4e0a\uff0c\u7b7e\u540d\u901a\u5e38\u662f\u968f\u8bc1\u4e66\u5370\u5237\u4e00\u4f53\u6210\u578b\u7684\u9ad8\u6e05\u7535\u5b50\u7b7e\u6216\u7531\u5b66\u6821\u6388\u6743\u624b\u5199\u3002\u7b7e\u540d\u7684\u7ebf\u6761\u6d41\u7545\uff0c\u7c97\u7ec6\u53d8\u5316\u81ea\u7136\uff0c\u5e26\u6709\u660e\u663e\u7684\u4e2a\u4eba\u4e66\u5199\u98ce\u683c\uff0c\u4e0e\u4e0b\u65b9\u7684\u804c\u4f4d\u804c\u79f0\u6587\u672c\u5448\u4e2d\u5fc3\u8f74\u5bf9\u79f0\u3002</p>"},{"location":"#_5","title":"\u65e5\u671f\u3001\u5e8f\u5217\u53f7\u4e0e\u7535\u5b50\u6838\u9a8c\u8ffd\u8e2a","text":"<p>\u5728\u8bc1\u4e66\u7684\u6700\u5e95\u90e8\uff0c\u8fd8\u7559\u6709\u4e00\u884c\u81f3\u5173\u91cd\u8981\u7684\u8ffd\u8e2a\u6570\u636e\uff0c\u8fd9\u662f\u6bcf\u4e00\u4f4d\u79d1\u5ef7\u5927\u5b66\u6bd5\u4e1a\u751f\u7684\u201c\u5b66\u672f\u8eab\u4efd\u8bc1\u201d\u3002</p> <ul> <li>\u9881\u53d1\u65e5\u671f\uff08Graduation Date\uff09\uff1a \u6837\u672c\u4e2d\u663e\u793a\u7684\u65e5\u671f\u683c\u5f0f\u4e3a\u6807\u51c6\u7684\u82f1\u5f0f\u8868\u8fbe\uff0c\u4f8b\u5982\u201c11 January 2026\u201d\u3002\u8fd9\u4e2a\u65e5\u671f\u901a\u5e38\u662f\u5927\u5b66\u5b98\u65b9\u5b66\u4f4d\u6388\u4e88\u5178\u793c\uff08Graduation Ceremony\uff09\u4e3e\u884c\u6216\u7406\u4e8b\u4f1a\u6b63\u5f0f\u6279\u51c6\u5b66\u4f4d\u7684\u65e5\u671f\u3002</li> <li>\u8bc1\u4e66\u5e8f\u5217\u53f7\uff08Diploma Serial Number\uff09\uff1a \u65e5\u671f\u53f3\u4fa7\u4f1a\u6709\u4e00\u4e32\u72ec\u4e00\u65e0\u4e8c\u7684\u7eaf\u6570\u5b57\u7f16\u53f7\uff08\u5982\u6837\u672c\u4e2d\u7684\u201c356560\u201d\uff09\u3002\u8be5\u7f16\u53f7\u4e0e\u5b66\u6821\u5185\u90e8\u7684\u7ba1\u7406\u7cfb\u7edf\u53ca\u6570\u636e\u5e93\u76f4\u63a5\u6302\u94a9\u3002</li> <li>\u6838\u9a8c\u903b\u8f91\uff1a \u968f\u7740\u6570\u5b57\u5316\u6821\u56ed\u7684\u53d1\u5c55\uff0c\u76ee\u524d\u6fb3\u6d32\u9ad8\u6821\u7684\u5b66\u4f4d\u8bc1\u4e66\u9664\u4e86\u7eb8\u8d28\u7248\u5916\uff0c\u8fd8\u666e\u904d\u63a5\u5165\u4e86\u6fb3\u6d32\u5b98\u65b9\u7684\u6bd5\u4e1a\u751f\u6570\u5b57\u5316\u6838\u9a8c\u5e73\u53f0\uff08\u5982My eQuals\uff09\u3002\u7528\u4eba\u5355\u4f4d\u5728\u62ff\u5230\u7eb8\u8d28\u8bc1\u4e66\u8fdb\u884c\u53c2\u7167\u6bd4\u5bf9\u65f6\uff0c\u53ef\u4ee5\u901a\u8fc7\u6838\u5bf9\u8bc1\u4e66\u5e95\u90e8\u7684\u5e8f\u5217\u53f7\u3001\u6bd5\u4e1a\u65e5\u671f\u4e0e\u7535\u5b50\u5e73\u53f0\u4e0a\u7684\u6570\u5b57\u5316\u5b89\u5168\u8bc1\u4e66\u662f\u5426\u5b8c\u5168\u543b\u5408\uff0c\u4ece\u800c\u5b9e\u73b0\u5168\u65b9\u4f4d\u7684\u95ed\u73af\u9a8c\u8bc1\u3002</li> </ul>"},{"location":"#_6","title":"\u603b\u7ed3","text":"<p>\u5bf9\u79d1\u5ef7\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08Curtin University diploma\uff09\u771f\u5b9e\u6837\u672c\u7684\u53c2\u7167\u4e0e\u6bd4\u5bf9\uff0c\u9700\u8981\u4ece\u5b8f\u89c2\u7684\u7248\u9762\u7f8e\u5b66\u4e00\u76f4\u6df1\u5165\u5230\u5fae\u89c2\u7684\u5b57\u95f4\u8ddd\u3001\u8272\u503c\u3001\u7b7e\u540d\u7ebf\u6761\u53ca\u7279\u79cd\u5370\u7ae0\u5de5\u827a\u3002\u4e00\u5f20\u5408\u683c\u3001\u771f\u5b9e\u7684\u5b66\u4f4d\u8bc1\u4e66\uff0c\u5176\u6bcf\u4e00\u4e2a\u6587\u5b57\u7684\u6392\u5217\u3001\u6bcf\u4e00\u4e2a\u89c6\u89c9\u5143\u7d20\u7684\u843d\u70b9\u90fd\u7ecf\u8fc7\u4e86\u5927\u5b66\u6ce8\u518c\u5904\uff08Official Office of the Academic Registrar\uff09\u7684\u4e25\u683c\u6821\u5bf9\u4e0e\u6807\u51c6\u5316\u5ba1\u5b9a\u3002\u5728\u6838\u67e5\u548c\u4e86\u89e3\u76f8\u5173\u6587\u4ef6\u65f6\uff0c\u4fdd\u6301\u5bf9\u8fd9\u4e9b\u7ec6\u8282\u7684\u4e25\u8c28\u5ba1\u89c6\uff0c\u4e0d\u4ec5\u80fd\u52a0\u6df1\u5bf9\u6d77\u5916\u9ad8\u7b49\u6559\u80b2\u8bc1\u4e66\u89c4\u8303\u7684\u8ba4\u77e5\uff0c\u4e5f\u4e3a\u4fdd\u969c\u7559\u5b66\u6210\u679c\u7684\u771f\u5b9e\u6027\u4e0e\u5408\u6cd5\u6743\u76ca\u5960\u5b9a\u4e86\u575a\u5b9e\u7684\u57fa\u7840\u3002</p>"}]}